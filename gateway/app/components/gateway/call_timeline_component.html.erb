<div class="flex flex-col gap-4">
  <div class="flex items-center justify-between">
    <span class="text-[13px] font-medium text-muted"><%= heading %></span>
    <% if stamp %><span class="font-mono text-xs text-muted"><%= stamp %></span><% end %>
  </div>
  <ol class="flex flex-col gap-3.5">
    <% steps.each do |step| %>
      <li class="flex gap-3.5 items-start">
        <span class="mt-0.5 size-5 rounded-full flex items-center justify-center shrink-0 <%= marker_classes(step) %>"><%= icon(marker_icon(step), class: "size-3.5") %></span>
        <div class="flex flex-col gap-0.5">
          <span class="text-sm font-medium"><%= step.title %></span>
          <% if step.meta %><span class="font-mono text-xs text-muted"><%= step.meta %></span><% end %>
        </div>
      </li>
    <% end %>
  </ol>
</div>
