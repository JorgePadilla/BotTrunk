<div class="flex flex-col gap-3">
  <details class="group" data-controller="clipboard" data-clipboard-text-value="<%= secret %>">
    <summary class="flex items-center justify-between gap-3 cursor-pointer list-none">
      <span class="font-mono text-sm group-open:hidden"><%= masked %></span>
      <span class="font-mono text-sm break-all hidden group-open:inline"><%= secret %></span>
      <span class="text-sm text-muted shrink-0 group-open:hidden">Show</span>
    </summary>
    <button type="button" class="btn btn-sm mt-3" data-action="clipboard#copy"><%= icon("copy") %> <span data-clipboard-target="label">Copy</span></button>
  </details>
  <%= button_to "Rotate secret", rotate_url, method: :post, class: "link link-hover text-sm text-muted self-start",
                form: { data: { turbo_confirm: "Rotate the secret? Calls are signed with the new one from now on, so update your API first." } } %>
</div>
