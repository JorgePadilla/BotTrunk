<%= render Ui::CardComponent.new(href: helpers.service_path(service), class: "flex flex-col gap-7") do %>
  <div class="flex flex-col gap-2">
    <h3 class="text-lg font-semibold tracking-tight"><%= service.name %></h3>
    <p class="text-[15px] text-muted"><%= service.summary %></p>
  </div>
  <div class="flex items-end justify-between">
    <%= render Catalog::PriceComponent.new(amount: service.price_usdc, suffix: "per call · #{service.latency}") %>
    <span class="text-[13px] text-muted"><%= service.provider %></span>
  </div>
<% end %>
