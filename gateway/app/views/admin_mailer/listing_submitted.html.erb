<p style="margin:0 0 16px 0;font-size:17px;font-weight:600;">A seller API is waiting for review</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px 0;">
  <%= receipt_row "API", @listing.name %>
  <%= receipt_row "Slug", "/s/#{@listing.slug}", mono: true %>
  <%= receipt_row "Price", "#{usdc(@listing.price_atomic)} USDC per call", mono: true %>
  <%= receipt_row "Endpoint", @listing.upstream_url, mono: true %>
  <%= receipt_row "Seller", @listing.seller.email %>
</table>

<p style="margin:0;"><%= mail_button "Review it", admin_listings_url %></p>
