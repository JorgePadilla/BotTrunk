<% content_for :title, "Sell your API to agents — BotTrunk" %>
<% content_for :description, "Sell your API to AI agents. Register an upstream URL and a price; BotTrunk hosts the paywall and pays you in USDC. Sellers keep 85%." %>
<% content_for :nav_active, "Sell" %>

<div class="flex flex-col gap-16 py-16 md:py-24">
  <div class="flex flex-col gap-4 max-w-2xl">
    <h1 class="text-4xl md:text-[40px] font-semibold tracking-[-0.03em] leading-[1.15]">Have an API? Agents will pay for it.</h1>
    <p class="text-lg text-muted">Give us an upstream URL and a price. We host the paywall, verify and settle every payment in USDC, and pay you out. No payment code, no billing, no chargebacks.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <% [
      [ "link", "1. Register", "Point us at your endpoint and set a price per call — from a fraction of a cent to whatever the work is worth." ],
      [ "shield-check", "2. We collect", "Agents hit bottrunk.com, get a 402, pay, and we forward the call to you only after the payment verifies." ],
      [ "wallet", "3. You get paid", "Settled USDC lands in your Algorand address. You keep 85% of every call; the rest is our fee." ]
    ].each do |icon_name, title, text| %>
      <%= render(Ui::CardComponent.new) do %>
        <div class="flex flex-col gap-3">
          <span class="size-9 rounded-full bg-base-200 flex items-center justify-center"><%= icon(icon_name) %></span>
          <h2 class="font-semibold tracking-tight"><%= title %></h2>
          <p class="text-sm text-muted"><%= text %></p>
        </div>
      <% end %>
    <% end %>
  </div>

  <hr class="hairline">

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_400px] gap-12 lg:gap-20 items-start">
    <section class="flex flex-col gap-10">
      <div class="flex flex-col gap-3.5">
        <h2 class="text-[22px] font-semibold tracking-tight">What sells</h2>
        <p class="text-muted">Anything an agent can't do alone and would rather pay for than build: scraping and extraction, sending messages to real phone numbers, verifying something in the physical world, translation a human has checked. Code you already run, or work a person does — both become one paid endpoint.</p>
      </div>
      <div class="flex flex-col gap-3.5">
        <h2 class="text-[22px] font-semibold tracking-tight">Pricing</h2>
        <dl class="flex flex-col text-sm">
          <% [ [ "Your share", "85% of every settled call" ], [ "Listing", "Free" ], [ "Minimum price", "0.01 USDC per call" ], [ "Payout", "USDC on Algorand, to the address you give us" ], [ "Failed upstream calls", "Not charged to the agent, not counted" ] ].each do |k, v| %>
            <div class="flex justify-between gap-6 py-3 border-b hairline"><dt class="text-muted"><%= k %></dt><dd class="text-right"><%= v %></dd></div>
          <% end %>
        </dl>
      </div>
      <div class="flex flex-col gap-3.5">
        <h2 class="text-[22px] font-semibold tracking-tight">Your endpoint</h2>
        <p class="text-muted">A public HTTPS URL that accepts a JSON <span class="font-mono">POST</span> and answers JSON. We forward the agent's body as-is and add nothing you need to parse. If you return a 5xx we don't charge the agent and don't count the call.</p>
      </div>
    </section>

    <aside class="lg:pt-1.5">
      <%= render(Ui::CardComponent.new(id: "early-access")) do %>
        <% if @submitted %>
          <div class="flex flex-col gap-3">
            <span class="size-9 rounded-full bg-base-200 text-success flex items-center justify-center"><%= icon("check") %></span>
            <h2 class="font-semibold tracking-tight">Got it.</h2>
            <p class="text-sm text-muted">A confirmation is on its way to your inbox. A person reviews every one of these and replies within a couple of days, whether the answer is yes or no — nothing is listed, and nothing can be charged, until it has been approved. Seller accounts and payouts open with the first public services in October.</p>
          </div>
        <% else %>
          <%= form_with model: @inquiry, url: seller_inquiries_path, class: "flex flex-col gap-4" do |f| %>
            <div class="flex flex-col gap-1">
              <h2 class="font-semibold tracking-tight">Request early access</h2>
              <p class="text-sm text-muted">Tell us what you'd sell. Takes a minute.</p>
            </div>
            <% if @inquiry.errors.any? %>
              <p class="text-sm text-error"><%= @inquiry.errors.full_messages.to_sentence %></p>
            <% end %>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Email</span>
              <%= f.email_field :email, class: "input w-full", placeholder: "you@company.com", required: true %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Service name</span>
              <%= f.text_field :service_name, class: "input w-full", placeholder: "Scrape URL to Markdown", required: true %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Upstream URL</span>
              <%= f.url_field :upstream_url, class: "input w-full font-mono", placeholder: "https://api.example.com/scrape", required: true %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Price per call (USDC)</span>
              <%= f.text_field :price_usdc, value: @inquiry.price_usdc, class: "input w-full font-mono", placeholder: "0.05", inputmode: "decimal", required: true %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Notes <span class="text-muted font-normal">(optional)</span></span>
              <%= f.text_area :notes, class: "textarea w-full", rows: 3, placeholder: "What it does, who it's for, expected latency…" %>
            </label>
            <%= render(Ui::ButtonComponent.new(variant: :primary, type: "submit", class: "w-full", icon: "arrow-right")) { "Request access" } %>
            <p class="text-xs text-muted text-center">No spam. One email when it's ready.</p>
          <% end %>
        <% end %>
      <% end %>
    </aside>
  </div>

  <hr class="hairline">

  <section id="request" class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_400px] gap-12 lg:gap-20 items-start scroll-mt-24">
    <div class="flex flex-col gap-10">
      <div class="flex flex-col gap-3.5">
        <h2 class="text-[22px] font-semibold tracking-tight">Buying, not selling?</h2>
        <p class="text-muted">Two things bring people here from the other side. Some work we do but arrange by hand first, because the scope has to be agreed before a price means anything. And some work nobody has listed yet — which is the more useful message to send us, because the catalog grows from it.</p>
      </div>

      <% if @arrangeable.any? %>
        <div class="flex flex-col gap-3.5">
          <h3 class="font-semibold tracking-tight">Arranged by hand</h3>
          <p class="text-sm text-muted">Real work, priced, not yet callable without a conversation. Ask here and it becomes a normal paid endpoint once the scope is agreed.</p>
          <dl class="flex flex-col text-sm">
            <% @arrangeable.each do |service| %>
              <div class="flex justify-between gap-6 py-3 border-b hairline">
                <dt><%= link_to service.name, service_path(service), class: "link link-hover" %><span class="block text-muted text-[13px] mt-0.5"><%= service.summary %></span></dt>
                <dd class="font-mono text-right whitespace-nowrap"><%= usdc(service.price_atomic) %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      <% end %>

      <div class="flex flex-col gap-3.5">
        <h3 class="font-semibold tracking-tight">What happens to a request</h3>
        <p class="text-muted">A person reads it and replies within a couple of days, whether the answer is yes or no. If we can do it, we either quote you directly or list it as an endpoint and send you the slug. If we can't, we say so — and if enough people ask for the same thing, that is how it gets built.</p>
      </div>
    </div>

    <aside class="lg:pt-1.5">
      <%= render(Ui::CardComponent.new(id: "request-form")) do %>
        <% if @requested %>
          <div class="flex flex-col gap-3">
            <span class="size-9 rounded-full bg-base-200 text-success flex items-center justify-center"><%= icon("check") %></span>
            <h2 class="font-semibold tracking-tight">Got it.</h2>
            <p class="text-sm text-muted">A confirmation is on its way to your inbox. A person reads every one of these and replies within a couple of days, whether the answer is yes or no.</p>
          </div>
        <% else %>
          <%= form_with model: @request, url: service_requests_path, class: "flex flex-col gap-4" do |f| %>
            <div class="flex flex-col gap-1">
              <h2 class="font-semibold tracking-tight">Ask for a service</h2>
              <p class="text-sm text-muted">Something we list, or something we don't.</p>
            </div>
            <% if @request.errors.any? %>
              <p class="text-sm text-error"><%= @request.errors.full_messages.to_sentence %></p>
            <% end %>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Email</span>
              <%= f.email_field :email, class: "input w-full", placeholder: "you@company.com", required: true %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">What you want</span>
              <%= f.select :service_slug,
                           Catalog::Service.all.map { |s| [ s.name, s.slug ] },
                           { include_blank: "Something you don't list yet" },
                           class: "select w-full" %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">What you need</span>
              <%= f.text_area :details, class: "textarea w-full", rows: 4, required: true,
                              placeholder: "What the work is, how often you'd need it, and what a good answer looks like." %>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
              <span class="font-medium">Budget per call <span class="text-muted font-normal">(optional, USDC)</span></span>
              <%= f.text_field :budget_usdc, value: @request.budget_usdc, class: "input w-full font-mono", placeholder: "5.00", inputmode: "decimal" %>
            </label>
            <%= render(Ui::ButtonComponent.new(variant: :primary, type: "submit", class: "w-full", icon: "arrow-right")) { "Send request" } %>
            <p class="text-xs text-muted text-center">A person replies either way.</p>
          <% end %>
        <% end %>
      <% end %>
    </aside>
  </section>
</div>
