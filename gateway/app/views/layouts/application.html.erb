<!DOCTYPE html>
<html lang="en" data-theme="<%= current_theme %>" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "BotTrunk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%= render Ui::NavbarComponent.new(active: content_for(:nav_active)) %>
    <main class="flex-1 w-full max-w-[1180px] mx-auto px-6 md:px-12">
      <%= yield %>
    </main>
    <footer class="border-t hairline">
      <div class="max-w-[1180px] mx-auto px-6 md:px-12 py-8 text-sm text-muted flex items-center justify-between">
        <span>© <%= Time.current.year %> BotTrunk</span>
        <span class="font-mono">api.bottrunk.com · x402 · Algorand</span>
      </div>
    </footer>
  </body>
</html>
