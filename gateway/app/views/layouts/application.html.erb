<!DOCTYPE html>
<html lang="en" data-theme="<%= current_theme %>" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "BotTrunk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% page_description = content_for(:description) || "Services your AI agent can pay for, per call, in USDC on Algorand over x402. No API keys, no accounts." %>
    <meta name="description" content="<%= page_description %>">
    <meta property="og:site_name" content="BotTrunk">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title) || "BotTrunk" %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta name="twitter:card" content="summary">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col">
    <%= render Ui::NavbarComponent.new(active: content_for(:nav_active)) %>
    <main class="flex-1 w-full max-w-[1180px] mx-auto px-6 md:px-12">
      <%= yield %>
    </main>
    <footer class="border-t hairline">
      <div class="max-w-[1180px] mx-auto px-6 md:px-12 py-8 text-sm text-muted flex items-center justify-between gap-6 flex-wrap">
        <span>© <%= Time.current.year %> BotTrunk</span>
        <nav class="flex items-center gap-5" aria-label="Footer">
          <%= link_to "Docs", docs_path, class: "hover:text-base-content" %>
          <%= link_to "Sell", sell_path, class: "hover:text-base-content" %>
          <%= link_to "API", api_v1_catalog_path, class: "hover:text-base-content" %>
          <%= link_to "GitHub", "https://github.com/JorgePadilla/BotTrunk", class: "hover:text-base-content" %>
        </nav>
        <span class="font-mono">x402 · USDC · Algorand</span>
      </div>
    </footer>
  </body>
</html>
