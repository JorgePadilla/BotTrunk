<% content_for :title, "BotTrunk — your agent can pay a person" %>
<% content_for :description, "A marketplace where AI agents pay per call in USDC over x402 on Algorand — from a page scrape to a bank deposit in Honduras made by a real person. No accounts, no API keys." %>
<% content_for :nav_active, "Catalog" %>

<div class="flex flex-col gap-14 py-16 md:py-24">
  <div class="flex flex-col gap-4 max-w-2xl">
    <h1 class="text-4xl md:text-[44px] font-semibold tracking-[-0.03em] leading-[1.1]">Your agent can pay a person.</h1>
    <p class="text-lg text-muted">Every other x402 catalog sells data. BotTrunk also sells work that happens in the real world — lempiras in someone's bank account in Honduras, with the receipt returned to your agent. Pay per call in USDC. No accounts, no API keys, no subscriptions.</p>
  </div>

  <% if @totals.any? %>
    <div class="flex flex-wrap items-center gap-x-10 gap-y-3 border-y hairline py-5">
      <div class="flex flex-col"><span class="font-mono text-2xl font-medium tabular-nums"><%= number_with_delimiter(@totals.calls) %></span><span class="text-[13px] text-muted">paid calls settled</span></div>
      <div class="flex flex-col"><span class="font-mono text-2xl font-medium tabular-nums"><%= usdc(@totals.volume) %></span><span class="text-[13px] text-muted">USDC moved on-chain</span></div>
      <div class="flex flex-col"><span class="font-mono text-2xl font-medium tabular-nums"><%= @totals.services %></span><span class="text-[13px] text-muted"><%= "service".pluralize(@totals.services) %> with real traffic</span></div>
      <p class="text-[13px] text-muted ml-auto max-w-xs">Measured from settled payments, not estimates<% if @totals.last_at %> · last call <%= time_ago_in_words(@totals.last_at) %> ago<% end %>.</p>
    </div>
  <% else %>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 border-y hairline py-4 text-sm text-muted">
      <span class="inline-flex items-center gap-2"><%= icon("check", class: "size-4 text-success") %>Live on Algorand MainNet</span>
      <span class="inline-flex items-center gap-2"><%= icon("check", class: "size-4 text-success") %>Settled by GoPlausible, USDC only</span>
      <span class="inline-flex items-center gap-2"><%= icon("check", class: "size-4 text-success") %>Nothing is charged when a call fails</span>
      <%= link_to "Read the protocol", docs_path, class: "underline underline-offset-4 hover:text-base-content ml-auto" %>
    </div>
  <% end %>

  <div class="flex items-center justify-between gap-6 flex-wrap">
    <%= render Catalog::FilterChipsComponent.new(categories: Catalog::Service.categories, active: @category, path: root_path) %>
    <span class="text-sm text-muted"><%= @services.size %> <%= "service".pluralize(@services.size) %></span>
  </div>

  <% if @query %>
    <p class="text-sm text-muted -mt-8">
      Matching <span class="font-medium text-base-content">“<%= @query %>”</span> ·
      <%= link_to "clear", root_path(category: @category), class: "underline underline-offset-4 hover:text-base-content" %>
    </p>
  <% end %>

  <% if @groups.empty? %>
    <div class="border hairline rounded-box py-16 flex flex-col items-center gap-3 text-center">
      <span class="size-9 rounded-full bg-base-200 flex items-center justify-center"><%= icon("search") %></span>
      <p class="font-medium">Nothing here yet.</p>
      <p class="text-sm text-muted max-w-sm">No service matches. Have an API that would? <%= link_to "Sell it here", sell_path, class: "underline underline-offset-4 hover:text-base-content" %>.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <% @groups.each do |primary, variants, metrics| %>
        <%= render Catalog::ServiceCardComponent.new(service: primary, metrics: metrics, variants: variants) %>
      <% end %>
    </div>
  <% end %>

  <hr class="hairline">

  <section class="flex flex-col gap-5">
    <div class="flex flex-col gap-2 max-w-2xl">
      <h2 class="text-[26px] font-semibold tracking-tight">Give your agent a wallet in two minutes.</h2>
      <p class="text-muted">One MCP server puts every service above into Claude, Cursor, VS Code, OpenClaw, Hermes, Goose or your own framework as a tool, price included. The key stays on your machine; spending caps are yours to set.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-8 items-start">
      <%= render Docs::CodeSnippetComponent.new(snippets: {
        "Terminal" => <<~SH.strip,
          npx bottrunk-mcp wallet        # creates the agent's wallet, prints its address
          # send it a little USDC on Algorand (and ~0.2 ALGO once), then:
          npx bottrunk-mcp wallet optin

          claude mcp add bottrunk -- npx -y bottrunk-mcp
        SH
        "Claude Desktop / Cursor" => <<~JSON.strip
          {
            "mcpServers": {
              "bottrunk": { "command": "npx", "args": ["-y", "bottrunk-mcp"] }
            }
          }
        JSON
      }) %>
      <ol class="flex flex-col gap-3 text-sm text-muted">
        <li><span class="text-base-content font-medium">1.</span> Your agent asks for a service and gets an HTTP 402 with the price.</li>
        <li><span class="text-base-content font-medium">2.</span> It signs a USDC transfer from its own wallet and retries.</li>
        <li><span class="text-base-content font-medium">3.</span> We verify, run the work, settle on Algorand and return the result with a receipt.</li>
        <li class="pt-1"><%= link_to "Steps for Cursor, VS Code, OpenClaw, Hermes and 8 more →", connect_path, class: "underline underline-offset-4 hover:text-base-content" %></li>
      </ol>
    </div>
  </section>

  <hr class="hairline">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-start">
    <section class="flex flex-col gap-3.5">
      <h2 class="text-[22px] font-semibold tracking-tight">Have an API? Sell it here.</h2>
      <p class="text-muted">Register an upstream URL and a price. We host the paywall, settle in USDC and pay you out — no payment code on your side. You keep 85% of every call.</p>
      <div class="mt-2">
        <%= render(Ui::ButtonComponent.new(href: "/sell", icon: "arrow-right")) { "Register a service" } %>
      </div>
    </section>
    <section class="flex flex-col gap-3.5">
      <h2 class="text-[22px] font-semibold tracking-tight">Work that needs hands?</h2>
      <p class="text-muted">Bank deposits, verification visits, translation — real people in Honduras behind an HTTP endpoint, paid per job. Tell us what your agent needs to get done and we will price it.</p>
      <div class="mt-2">
        <%= render(Ui::ButtonComponent.new(href: "mailto:hello@bottrunk.com?subject=Human-fulfilled%20service", icon: "mail")) { "Ask for a service" } %>
      </div>
    </section>
  </div>
</div>
