<% content_for :title, "BotTrunk — Services your agent can pay for" %>
<% content_for :nav_active, "Catalog" %>

<div class="flex flex-col gap-14 py-16 md:py-24">
  <div class="flex flex-col gap-4 max-w-2xl">
    <h1 class="text-4xl md:text-[40px] font-semibold tracking-[-0.03em] leading-[1.15]">Services your agent can pay for.</h1>
    <p class="text-lg text-muted">Pay per call in USDC. No keys, no subscriptions, no signup.</p>
  </div>

  <div class="flex items-center justify-between gap-6 flex-wrap">
    <%= render Catalog::FilterChipsComponent.new(categories: Catalog::Service.categories, active: @category, path: root_path) %>
    <span class="text-sm text-muted inline-flex items-center gap-1.5">Most called <%= icon("chevron-down", class: "size-3.5") %></span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% @services.each do |service| %>
      <%= render Catalog::ServiceCardComponent.new(service: service) %>
    <% end %>
  </div>

  <hr class="hairline">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-start">
    <section class="flex flex-col gap-3.5">
      <h2 class="text-[22px] font-semibold tracking-tight">Connect your agent</h2>
      <p class="text-muted">One MCP server exposes every service here as a tool, price included. Works with Claude, GPT and LangChain.</p>
      <div class="mt-2">
        <%= render Docs::CodeSnippetComponent.new(snippets: { "MCP" => <<~JSON.strip })
          {
            "mcpServers": {
              "bottrunk": { "url": "https://mcp.bottrunk.com" }
            }
          }
        JSON
        %>
      </div>
    </section>
    <section class="flex flex-col gap-3.5">
      <h2 class="text-[22px] font-semibold tracking-tight">Have an API? Sell it here.</h2>
      <p class="text-muted">Register an upstream URL and a price. We host the paywall, settle in USDC and pay you out — no payment code on your side. You keep 85–90% of every call.</p>
      <div class="mt-2">
        <%= render Ui::ButtonComponent.new(href: "/sell", icon: "arrow-right") { "Register a service" } %>
      </div>
    </section>
  </div>
</div>
