<p style="margin:0 0 16px 0;font-size:17px;font-weight:600;">Your payout is on its way.</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px 0;">
  <%= receipt_row "Amount", "#{usdc(@payout.amount)} USDC", mono: true %>
  <%= receipt_row "To", @payout.seller.payout_address, mono: true %>
  <%= receipt_row "Transaction", @payout.transaction_id, mono: true %>
  <%= receipt_row "Note", @payout.notes %>
  <%= receipt_row "Still owed", "#{usdc(@payout.seller.owed_atomic)} USDC", mono: true %>
</table>

<p style="margin:0 0 22px 0;"><%= mail_button "See it on the Algorand explorer", explorer_url(@payout.transaction_id) %></p>

<p style="margin:0;color:#666666;font-size:13px;">Something looks wrong? Reply to this email.</p>
