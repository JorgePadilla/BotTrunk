<% content_for :title, "Jobs — BotTrunk admin" %>

<div class="flex flex-col gap-14 py-12 md:py-16">
  <header class="flex flex-col gap-3">
    <%= render Dashboard::AdminNavComponent.new(active: "Jobs", jobs: @queue.size) %>
    <h1 class="text-4xl font-semibold tracking-[-0.03em]">Jobs to do</h1>
    <p class="text-muted">Each row is USDC already settled on-chain. Do the work, paste the result, mark it delivered. If you cannot deliver, send the USDC back from the gateway wallet and record the refund transaction — the buyer was promised that.</p>
    <% if flash[:notice] %><p class="text-sm text-success"><%= flash[:notice] %></p><% end %>
    <% if flash[:alert] %><p class="text-sm text-error"><%= flash[:alert] %></p><% end %>
  </header>

  <section class="flex flex-col gap-5">
    <h2 class="text-[22px] font-semibold tracking-tight">Queue · <%= @queue.size %> pending</h2>
    <% if @queue.empty? %>
      <p class="text-sm text-muted">Nothing waiting.</p>
    <% end %>
    <% @queue.each do |order| %>
      <%= render Ui::CardComponent.new(class: "flex flex-col lg:flex-row lg:items-start justify-between gap-8") do %>
        <div class="flex flex-col gap-2 min-w-0">
          <div class="flex items-baseline gap-3 flex-wrap">
            <span class="font-mono text-2xl font-medium"><%= usdc(order.price_atomic) %> USDC</span>
            <span class="text-muted"><%= order.service_slug %></span>
            <%= render(Ui::PillComponent.new(tone: :success, icon: "check")) { "USDC settled" } %>
          </div>
          <p class="text-sm whitespace-pre-wrap max-w-2xl"><%= order.brief %></p>
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-sm">
            <% order.params.each do |key, value| %>
              <dt class="text-muted"><%= key.to_s.humanize %></dt><dd class="font-medium"><%= value %></dd>
            <% end %>
            <dt class="text-muted">Ordered</dt><dd><%= order.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %> · due by <%= (order.created_at + 5.days).utc.strftime("%m-%d") %><% if order.contact_email %> · <%= order.contact_email %><% end %></dd>
            <dt class="text-muted">Order</dt><dd class="font-mono text-muted"><%= order.token %></dd>
          </dl>
        </div>
        <div class="flex flex-col gap-3 lg:w-96 shrink-0">
          <%= form_with url: admin_deliver_work_order_path(order.token), method: :post, class: "flex flex-col gap-2" do |f| %>
            <%= f.text_area :result, placeholder: "The result as JSON — one entry per supplier. Anything that is not JSON is kept as a note.", rows: 6, class: "textarea w-full font-mono text-xs" %>
            <%= f.button "Mark delivered", class: "btn btn-neutral" %>
          <% end %>
          <details class="text-sm">
            <summary class="cursor-pointer text-muted">Could not deliver — refund</summary>
            <%= form_with url: admin_refund_work_order_path(order.token), method: :post, class: "flex flex-col gap-2 mt-2" do |f| %>
              <%= f.text_field :refund_transaction_id, placeholder: "Algorand txn id of the USDC refund", required: true, class: "input w-full font-mono", autocomplete: "off" %>
              <%= f.text_field :notes, placeholder: "Why (nobody quoted, spec impossible…)", class: "input w-full" %>
              <%= f.button "Mark refunded", class: "btn btn-outline" %>
            <% end %>
          </details>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="flex flex-col gap-4">
    <h2 class="text-[22px] font-semibold tracking-tight">Done · last <%= @done.size %></h2>
    <%= render Dashboard::TableComponent.new(
      columns: [ "When (UTC)", "Status", "Service", "Paid", "Refund txn", "Order" ], numeric: [ 3 ],
      rows: @done.map { |o| [
        (o.delivered_at || o.refunded_at || o.updated_at).utc.strftime("%m-%d %H:%M"),
        (o.status == "delivered" ? tag.span("delivered", class: "text-success") : tag.span("refunded", class: "text-error")),
        o.service_slug, usdc(o.price_atomic),
        tag.span(o.refund_transaction_id.presence || "—", class: "font-mono"), tag.span(o.token, class: "font-mono text-muted")
      ] },
      empty: "No jobs finished yet."
    ) %>
  </section>

  <% if @abandoned.any? %>
    <section class="flex flex-col gap-4">
      <h2 class="text-[22px] font-semibold tracking-tight">Never paid</h2>
      <p class="text-sm text-muted">Jobs opened by a request whose USDC never settled. Nothing is owed.</p>
      <%= render Dashboard::TableComponent.new(
        columns: [ "When (UTC)", "Status", "Service", "Order" ],
        rows: @abandoned.map { |o| [ o.created_at.utc.strftime("%m-%d %H:%M"), o.status.tr("_", " "), o.service_slug, tag.span(o.token, class: "font-mono text-muted") ] }
      ) %>
    </section>
  <% end %>
</div>
