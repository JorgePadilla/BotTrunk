#!/usr/bin/env bash
# Ensures a project-local Python venv (.venv, git-ignored) with the spike's
# dependencies, and prints the path to its python. Used by bin/pay and bin/agent-wallet.
# Prefers a Python that has prebuilt wheels for pynacl/cffi (3.11–3.13).
set -euo pipefail
cd "$(dirname "$0")/.."

pick_python() {
  for candidate in python3.12 python3.13 python3.11 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then echo "$candidate"; return; fi
  done
}

if [ ! -x .venv/bin/python ]; then
  rm -rf .venv
  PY="$(pick_python)"
  echo "creating .venv with $PY ($("$PY" --version))" >&2
  if ! "$PY" -m venv .venv >&2; then
    # Homebrew Pythons sometimes fail ensurepip; build the venv without pip and
    # install into it with the system pip instead.
    echo "ensurepip failed; creating the venv without pip" >&2
    rm -rf .venv
    "$PY" -m venv --without-pip .venv >&2
  fi
fi

if ! .venv/bin/python -c "import algosdk, requests" 2>/dev/null; then
  echo "installing py-algorand-sdk + requests into .venv (one time)" >&2
  if [ -x .venv/bin/pip ]; then
    .venv/bin/pip install py-algorand-sdk requests >&2
  else
    PY="$(pick_python)"
    "$PY" -m pip --python .venv/bin/python install py-algorand-sdk requests >&2
  fi
fi
echo "$PWD/.venv/bin/python"
